# Local development only. These are not production secrets.
# The API refuses to start unless DATABASE_URL logs in as omnivate_app,
# so PostgreSQL row-level security actually applies.

DATABASE_URL=postgres://omnivate_app:omnivate_local_dev_only@localhost:5432/omnivate
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/omnivate

API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Optional. Company session lifetime in seconds. Default 900. Allowed range 60 to 3600.
# SESSION_TTL_SECONDS=900
# Optional. Operator session lifetime in seconds. Default 600. Allowed range 60 to 900.
# OPERATOR_SESSION_TTL_SECONDS=600
# Optional. Where tenant logos are stored. Default is data/branding in the repo.
# On Render's free plan this disk is wiped when the service restarts.
# BRANDING_STORAGE_DIR=
# Set true behind HTTPS so the session cookie is not sent over plain HTTP.
# COOKIE_SECURE=false

# Optional. 'on' (default) requires an authenticator for owner, manager,
# accountant, HR, and platform operators. 'off' skips that prompt and keeps
# any enrolled secret. Set this to on before real client data.
# MFA_ENFORCEMENT=on

# Optional for local sign-in. Live Build Progress needs a token that can
# read pull requests, because this repository is private. Without it, Overview
# shows docs/progress/roadmap.json.
# GITHUB_TOKEN=

# Document capture. Each company chooses Standard or Premium in the control panel.
# Standard stays on the server and needs no key. Premium uses the key below.
# DOCUMENT_READER_PROVIDER=demo is a local test switch. Leave it unset otherwise.
# OPENAI_API_KEY=
# DOCUMENT_READER_MODEL=gpt-4o-mini
# DOCUMENT_STORAGE_DIR=data/documents

# The hosted preview does not use this file. Render generates OMNIVATE_APP_PASSWORD,
# injects the database owner's connection as DATABASE_ADMIN_URL, and the start
# command builds DATABASE_URL for omnivate_app. Leave VITE_PREVIEW unset locally.
